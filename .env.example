# ==============================================
# GreekLingua Dashboard - Environment Variables
# ==============================================
# Kopiere diese Datei zu .env.local und fülle die Werte aus
#
# WICHTIG: Niemals .env.local in Git committen!
# ==============================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Admin IP Whitelisting (optional)
# Komma-separierte Liste von erlaubten IPs für Admin-Login
# Leer lassen = Alle IPs erlaubt (NUR für Entwicklung!)
# Beispiel: NEXT_PUBLIC_ADMIN_ALLOWED_IPS=192.168.1.100,203.0.113.42
NEXT_PUBLIC_ADMIN_ALLOWED_IPS=

# ==============================================
# Supabase Secrets (via Supabase CLI)
# ==============================================
# Diese Secrets müssen in Supabase gesetzt werden:
#
# supabase secrets set TELEGRAM_BOT_TOKEN=your_bot_token_here
# supabase secrets set TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here
#
# ==============================================
